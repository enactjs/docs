---
const {
	button,
	headerTitle,
	title
} = Astro.locals.starlightRoute.entry.data;

import {LinkButton} from '@astrojs/starlight/components';

import css from './TitleWithButton.module.css';
---

<div class={css.titleWrapper}>
	<h1 class={css.title} id="_top">{headerTitle || title}</h1>
	{button &&
			<div class={css.buttonContainer}>
				<LinkButton
						class={css.button}
						href={button.href}
						icon="github"
						iconPlacement="end"
						target="_blank"
				>
					{button.label}
				</LinkButton>
			</div>
	}
</div>
