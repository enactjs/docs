---
import {Code, Badge} from "@astrojs/starlight/components";
import {
	DocParse,
	Heading,
	LivePreview,
	MemberComponent,
	MemberFunction,
	MemberHoC,
	MemberObject,
	MemberProperties,
	ModuleImport,
	ModuleSchema
} from '../index';
import {getJSONData, getMemberData, getMembers} from "./utils";

import css from './Page.module.css';

// Component Props
const {frontmatter: {docsPath}} = Astro.props;

// JSON docs Data
const data = await getJSONData(docsPath);

// Title, module name, description and code
const title = data.name?.split('/')[1];
const moduleName = data.name || 'API Documentation';
const code = data.tags.find((tag) => tag.title === 'example')?.description?.replace(/[\n\r\t]/g, '').replace(/'/g, '"');

// Extract members
const members = getMembers(data);

// Member data
const memberData = getMemberData(members);
---

<>
	<DocParse doc={data.description} />
	{code && <LivePreview client:only="react" code={code} name={moduleName} />}
	<ModuleImport moduleName={moduleName} title={title} />
	{members.length &&
		<Heading title="Type Definitions" level={2} />
		<>
			{memberData.map((member) => {
				return (
					<>
					<!--Render Heading Component-->
					{member.isTypeDefObject && 	<Heading title="Type Definitions" level={2} />}
					<Heading title={member.name} level={3}>
						&ensp;
						<Badge
							class={css.headingBadge}
							size="medium"
							style={{color: member.badgeColor}}
							text={member.badgeType}
						/>
					</Heading>
					<div class={css.headingSeparator} />
					<!--Render Member High-Order Component-->
					{member.isHoC &&
						<MemberHoC member={member}>
							<ModuleImport moduleName={member.memberOf} title={member.name} />
							<MemberProperties
								isHoC={member.isHoC}
								properties={member.properties}
								staticProperties={member.staticProperties}
							/>
							<ModuleSchema isHoC={member.isHoC} tags={member.tags} />
						</MemberHoC>
					}
					<!--Render Member Component-->
					{member.isComponent &&
						<MemberComponent member={member}>
							<ModuleImport moduleName={member.memberOf} title={member.name} />
							<MemberProperties
								isHoC={member.isHoC}
								properties={member.properties}
								staticProperties={member.staticProperties}
							/>
							<ModuleSchema isComponent={member.isComponent} tags={member.tags} />
						</MemberComponent>
					}
					<!--Render Member Function-->
					{member.isFunction &&
						<MemberFunction member={member} />
					}
					<!--Render Member Object-->
					{(member.isObject || member.isTypeDefObject) &&
						<MemberObject member={member} />
					}
				</>
				)
			})}
		</>
	}
</>
