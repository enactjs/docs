---
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import css from './Header.module.css';
import {PAGE} from "../../consts";

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const currentPage = Astro.locals.starlightRoute.id;
const isHomePage = currentPage === '' ? 'home' : '';
const isApiPage = currentPage === PAGE.API ? currentPage : '';
const isModulesPage = currentPage.includes(PAGE.MODULES) ? PAGE.MODULES : '';
const isDocsPage = currentPage === PAGE.DOCS ? currentPage : '';
const isDeveloperToolsPage = currentPage === PAGE.DEVELOPER_TOOLS ? currentPage : '';
const isDeveloperGuidePage = currentPage === PAGE.DEVELOPER_GUIDE ? currentPage : '';
const isTutorialsPage = currentPage === PAGE.TUTORIALS ? currentPage : '';
---

<div class={css.headerContainer}>
	<div class={css.navigationContainer}>
		<SiteTitle />
		<div class={css.navigationLinks}>
			<div class={css.search}>
				{shouldRenderSearch && <Search />}
			</div>
			<nav class={css.links}>
				<a class:list={[css.link, css[isHomePage]]} href="/">Home</a>
				<a class:list={[css.link, css[isDocsPage]]} href="/docs/">Getting Started</a>
				<a class:list={[css.link, css[isApiPage], css[isModulesPage]]} href="/api/">API</a>
				<a class={css.link} href="https://github.com/enactjs/enact" target="_blank">GitHub</a>
				<a class={css.link} href="https://enactjs.com/sampler" target="_blank">UI Components</a>
			</nav>
		</div>
	</div>
	<div class={css.themeSelect}>
		<ThemeSelect />
	</div>
</div>

{(isApiPage || isModulesPage || isDeveloperGuidePage || isDeveloperToolsPage || isTutorialsPage) &&
	<div class:list={[css.additionalHeaderContainer, "custom-nav-header"]}>
		<nav class={css.links}>
			<a class:list={[css.link, css[isApiPage], css[isModulesPage]]} href="/api/">API Libraries</a>
			<a class:list={[css.link, css[isDeveloperGuidePage]]} href="/guide/">Developer Guide</a>
			<a class:list={[css.link, css[isDeveloperToolsPage]]} href="/tools/">Developer Tools</a>
			<a class:list={[css.link, css[isTutorialsPage]]} href="/tutorials/">Tutorials</a>
		</nav>
	</div>
}

<style>
	@layer starlight.core {
		:global(:root) {
			--sl-nav-height: 6rem;
			--sl-color-bg-nav: #fff;
		}

		:global(:root:has(.custom-nav-header)) {
			.main-pane, .sidebar-pane {
				margin-top: 3.5rem;
			}
		}
	}
</style>