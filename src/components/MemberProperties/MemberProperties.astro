---
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import Properties from './Properties';
import PropsBadge from './PropsBadge.astro';
import PropsNameAnchor from './PropsNameAnchor.astro';
import {getPropertiesData} from "./utils";

import css from './MemberProperties.module.css';

const {isHoC, properties, staticProperties} = Astro.props;

const [props, staticProps] = getPropertiesData(properties, staticProperties);
const isStaticProperties = staticProps.length > 0;
const isProperties = props.length > 0;
---

<!--Render Configuration-->
{isStaticProperties && <h5 className={css.header}>Configuration</h5>}
{isStaticProperties && staticProps.map((data, index) => {
	return (
		<>
			<Properties propsData={data}>
				<PropsNameAnchor propName={data.propName} requiredProp={data.required} />
				<PropsBadge badgeTypes={data.propType} />
			</Properties>
			{(index < props.length - 1) && <hr />}
		</>
	)
})}

<!--Render Properties-->
{isProperties && <h5 className={css.header}>Properties {isHoC ? 'added to wrapped component' : ''}</h5>}
{isProperties && props.map((data, index) => {
	return (
		<>
			<Properties propsData={data}>
				<PropsNameAnchor propName={data.propName} requiredProp={data.required} />
				<PropsBadge badgeTypes={data.propType} />
			</Properties>
			{(index < staticProps.length - 1) && <hr />}
		</>
	)
})}
