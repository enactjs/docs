---
import {Badge} from "@astrojs/starlight/components";
import {getPropertyTypeColor} from "../utils";

import css from './MemberProperties.module.css';

const {badgeTypes = []} = Astro.props;
---

{badgeTypes.map((type) => {
	return (
		<Badge
			class={css.propsBadge}
			text={type.trim()}
			size="small"
			style={{color: getPropertyTypeColor(type.trim())}}
		/>
	)}
)}

