---
import {LinkButton} from '@astrojs/starlight/components';
import {PAGE} from "../../consts";

import css from './Footer.module.css';

const isModulesPage = Astro.locals.starlightRoute.id.includes(PAGE.MODULES);
const isDeveloperGuidePage = Astro.locals.starlightRoute.id.includes(`${PAGE.DEVELOPER_GUIDE}/`);
const isDeveloperToolsPage = Astro.locals.starlightRoute.id.includes(`${PAGE.DEVELOPER_TOOLS}/`);
const isTutorialsPage = Astro.locals.starlightRoute.id.includes(`${PAGE.TUTORIALS}/`);

const developerToolsStyle = Astro.locals.starlightRoute.id === PAGE.DEVELOPER_TOOLS ? PAGE.DEVELOPER_TOOLS : '';
---

{(!isModulesPage && !isTutorialsPage && !isDeveloperGuidePage && !isDeveloperToolsPage) &&
	<footer class:list={[css.footer, css[developerToolsStyle]]}>
		<div class={css.frame}>
			<div class={css.nav}>
				<LinkButton class={css.button} href="/about/">About Us</LinkButton>
				<LinkButton class={css.button} href="/legal/">Legal</LinkButton>
				<LinkButton class={css.button} href="/cookie/">Cookie Policy</LinkButton>
				<LinkButton class={css.button} href="/contact/">Contact Us</LinkButton>
				<LinkButton class={css.button} href="/uses/">Use Cases</LinkButton>
			</div>
			<div class={css.socialContainer}>
				<div class={css.social}>
					<LinkButton class={css.button} href="https://twitter.com/EnactJS">Twitter</LinkButton>
					<LinkButton class={css.button} href="https://gitter.im/EnactJS/Lobby">Chat</LinkButton>
					<LinkButton class={css.button} href="https://medium.com/enact-js">Blog</LinkButton>
				</div>
				<p class={css.copy}>
					Copyright &copy; 2017-{new Date().getFullYear()} LG Electronics
				</p>
			</div>
		</div>
	</footer>
}