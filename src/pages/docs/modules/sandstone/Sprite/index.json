                                  "type": "inlineCode",
                                  "value": "playing"
                                },
                                {
                                  "type": "text",
                                  "value": ": boolean representing the \"playing\" vs \"stopped\" state"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "spread": false,
                          "children": [
                            {
                              "type": "paragraph",
                              "children": [
                                {
                                  "type": "inlineCode",
                                  "value": "paused"
                                },
                                {
