  {
    "description": {
      "type": "root",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "A \"sprite\" is an animated sequence of cells."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Cells, like a filmstrip, are pre-arranged in one or more rows and one or more columns.\nThis component steps through those cells to create an animation."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Example:"
            }
          ]
        },
        {
          "type": "code",
          "lang": null,
          "meta": null,
          "value": "<Sprite\n\tsrc=\"images/sprite-sheet.png\"\n\theight={60}\n\twidth={60}\n\trows={5}\n\tcolumns={10}\n/>"
        }
      ]
    },
