        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "A higher-order component that provides access to the properties of the i18nContext via props.\nThis is achieved by specifying the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "localeProp"
                  },
                  {
                    "type": "text",
                    "value": ", "
                  },
                  {
                    "type": "inlineCode",
                    "value": "rtlProp"
                  },
                  {
                    "type": "text",
                    "value": ", and "
                  },
                  {
                    "type": "inlineCode",
                    "value": "updateLocaleProp"
                  },
                  {
                    "type": "text",
                    "value": " configuration options.\nSet the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "localeProp"
                  },
                  {
                    "type": "text",
                    "value": " to a desired prop name to access the "
                  },
                  {
                    "type": "link",
                    "url": "/docs/developer-guide/i18n/#using-i18ndecorator",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "locale"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " property,\nset the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "rtlProp"
                  },
                  {
                    "type": "text",
                    "value": " to a desired prop name to access the "
                  },
                  {
                    "type": "link",
                    "url": "/docs/developer-guide/i18n/#using-i18ndecorator",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "rtl"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " property,\nand set the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "updateLocaleProp"
                  },
                  {
                    "type": "text",
                    "value": " to a desired prop name to access the "
                  },
                  {
                    "type": "link",
                    "url": "/docs/developer-guide/i18n/#using-i18ndecorator",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "updateLocale"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " function,\nwhich is used to update the current locale."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const Component = ({rtl, _updateLocale}) => {\n\tconst handleClick = () => _updateLocale('ar-SA');\n\treturn (\n\t\t<button onClick={handleClick}>{rtl ? 'rtl' : 'ltr'}</button>\n\t);\n};\n\nconst SomeComponent = I18nContextDecorator(\n\t\t{rtlProp: 'rtl', updateLocaleProp: '_updateLocale'},\n\t\tComponent\n)\n"
              }
            ]
          },
