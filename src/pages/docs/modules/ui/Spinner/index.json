    "description": {
      "type": "root",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "An unstyled indeterminate progress indicator (Spinner) component to be customized by a\ntheme or application."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Basically, this positions your "
            },
            {
              "type": "inlineCode",
              "value": "Spinner"
            },
            {
              "type": "text",
              "value": " component where you want it on the\nscreen, and hooks into the interaction blocking code and scrim management."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "The theme using this component must supply a "
            },
            {
              "type": "inlineCode",
              "value": "component"
            },
            {
              "type": "text",
              "value": " element which follows the requirements\nlisted by the "
            },
            {
              "type": "link",
              "url": "ui/Spinner.Spinner.component",
              "title": null,
              "jsdoc": true,
              "children": [
                {
                  "type": "text",
                  "value": "component"
                }
              ]
            },
            {
              "type": "text",
              "value": " prop documentation."
            }
          ]
        }
      ]
    },
