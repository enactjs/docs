                      "children": [
                        {
                          "type": "text",
                          "value": "A theme-supplied component that performs the animation."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "children": [
                        {
                          "type": "text",
                          "value": "Theme authors can use the "
                        },
                        {
                          "type": "inlineCode",
                          "value": "css.running"
                        },
                        {
                          "type": "text",
                          "value": " class to attach the animation CSS.\nThis element should accept a "
                        },
                        {
                          "type": "inlineCode",
                          "value": "children"
                        },
                        {
                          "type": "text",
                          "value": " prop which takes the form of an optional message\nfor the user."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "children": [
                        {
                          "type": "text",
                          "value": "Unlike most other components, this does "
                        },
                        {
                          "type": "emphasis",
                          "children": [
                            {
                              "type": "text",
                              "value": "not"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "value": " represent the root rendered element, and\ninstead refers to the \"spinner\" part of this component. The presence of "
                        },
                        {
                          "type": "inlineCode",
                          "value": "blockClickOn"
                        },
                        {
                          "type": "text",
                          "value": "\nchanges the rendering tree and where this is used."
