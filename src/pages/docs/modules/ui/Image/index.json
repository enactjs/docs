              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "A basic image component designed to display images conditionally based on screen size."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "This component does not have a default size, therefore the image will not show unless a size is\nspecified using a CSS "
                  },
                  {
                    "type": "inlineCode",
                    "value": "className"
                  },
                  {
                    "type": "text",
                    "value": " or inline "
                  },
                  {
                    "type": "inlineCode",
                    "value": "style"
                  },
                  {
                    "type": "text",
                    "value": "."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const src = {\n  'hd': 'http://lorempixel.com/64/64/city/1/',\n  'fhd': 'http://lorempixel.com/128/128/city/1/',\n  'uhd': 'http://lorempixel.com/256/256/city/1/'\n};\n\n<Image className={css.myImage} src={src} sizing=\"fill\" />"
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "inlineCode",
                    "value": "ui/Image"
                  },
                  {
                    "type": "text",
                    "value": " is based on the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "div"
                  },
                  {
                    "type": "text",
                    "value": " element, but it uses "
                  },
                  {
                    "type": "inlineCode",
                    "value": "img"
                  },
                  {
                    "type": "text",
                    "value": " to provide "
                  },
                  {
                    "type": "inlineCode",
                    "value": "onError"
                  },
                  {
                    "type": "text",
                    "value": " and "
                  },
                  {
                    "type": "inlineCode",
                    "value": "onLoad"
                  },
                  {
                    "type": "text",
                    "value": "\nevents. The image that you see on screen is a "
                  },
                  {
                    "type": "inlineCode",
                    "value": "background-image"
                  },
                  {
                    "type": "text",
                    "value": " from the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "div"
                  },
                  {
                    "type": "text",
                    "value": " element, not the\n"
                  },
                  {
                    "type": "inlineCode",
                    "value": "img"
                  },
                  {
                    "type": "text",
                    "value": " element."
                  }
                ]
              },
              {
                "type": "blockquote",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "text",
                        "value": "If you need a naturally sized image, you can use the native "
                      },
                      {
                        "type": "inlineCode",
                        "value": "<img>"
                      },
                      {
                        "type": "text",
                        "value": " element instead."
                      }
                    ]
                  }
                ]
              }
            ]
