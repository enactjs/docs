      "static": [
        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Utility to either create or clone a component instance with the given set of props."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "inlineCode",
                    "value": "ComponentOverride"
                  },
                  {
                    "type": "text",
                    "value": " can be used to support props that either accept a type, (e.g. "
                  },
                  {
                    "type": "inlineCode",
                    "value": "Button"
                  },
                  {
                    "type": "text",
                    "value": ") or an\nelement (e.g. "
                  },
                  {
                    "type": "inlineCode",
                    "value": "<Button customProp=\"value\" />"
                  },
                  {
                    "type": "text",
                    "value": ") and return a new element which includes the\nremaining props specified."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const LabeledIconButton = ({iconComponent, label, ...rest}) => {\n  return (\n    <div {...rest}>\n      <ComponentOverride\n        component={iconComponent}\n        icon=\"house\"\n      />\n      <span>{label}</span>\n    </div>\n  );\n};\n\n// Usage\n\n// Only the props defined by LabeledIconButton will be passed to CustomIcon\n<LabeledIconButton\n  label=\"Home\"\n  iconComponent={CustomIcon}\n/>\n\n// The color prop along with props defined by LabeledIconButton will be passed to CustomIcon\n<LabeledIconButton\n  label=\"Home\"\n  iconComponent={\n    <CustomIcon color=\"green\" />\n  }\n/>"
              }
            ]
          },
