            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "A higher-order component that provides a function to its wrapped component which can be\ncalled to alert the user for accessibility notifications."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "By default, the function is passed in the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "announce"
                  },
                  {
                    "type": "text",
                    "value": " prop but may be customized by specifying the\n"
                  },
                  {
                    "type": "inlineCode",
                    "value": "prop"
                  },
                  {
                    "type": "text",
                    "value": " config member. In addition to the configured prop, this HoC also adds an additional child\ncomponent to the passed "
                  },
                  {
                    "type": "inlineCode",
                    "value": "children"
                  },
                  {
                    "type": "text",
                    "value": " prop."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "import AnnounceDecorator from '@enact/ui/AnnounceDecorator';\nimport {Component} from 'react';\n\nconst Example = AnnounceDecorator(class extends Component {\n  static propTypes = {\n    // passed by AnnounceDecorator\n    announce: PropTypes.func\n  }\n\n  notify = () => {\n    const {announce} = this.props;\n    announce('this text will be alerted to user by TTS');\n  }\n\n  render () {\n    <div>\n      <button onClick={this.notify}>Notify on Click</button>\n    </div>\n  }\n});"
              }
            ]
          },
