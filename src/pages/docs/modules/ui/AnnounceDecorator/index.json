                "children": [
                  {
                    "type": "text",
                    "value": "An unstyled component with an imperative API to alert the user."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "The "
                  },
                  {
                    "type": "inlineCode",
                    "value": "announce()"
                  },
                  {
                    "type": "text",
                    "value": " method should be used to alert the user of behavior for accessibility."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "import {Announce} from '@enact/ui/AnnounceDecorator';\nimport {Component} from 'react';\n\nclass Example extends Component {\n  notify = () => {\n    if (this.announce) {\n      this.announce.announce('this text will be alerted to user by TTS');\n    }\n  }\n\n  setAnnounceRef = (announce) => {\n    this.announce = announce;\n  }\n\n  render () {\n    <div>\n      <button onClick={this.notify}>Notify on Click</button>\n      <Announce ref={this.setAnnounceRef} />\n    </div>\n  }\n}"
              }
            ]
