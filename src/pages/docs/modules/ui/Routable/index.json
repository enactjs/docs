        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "A component that is used to make a link to navigate among "
                  },
                  {
                    "type": "link",
                    "url": "ui/Routable.Route",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "Route"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " components."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "In the following example, "
                  },
                  {
                    "type": "inlineCode",
                    "value": "Sample"
                  },
                  {
                    "type": "text",
                    "value": " would render "
                  },
                  {
                    "type": "inlineCode",
                    "value": "Main"
                  },
                  {
                    "type": "text",
                    "value": " with two Links for "
                  },
                  {
                    "type": "inlineCode",
                    "value": "About"
                  },
                  {
                    "type": "text",
                    "value": " and "
                  },
                  {
                    "type": "inlineCode",
                    "value": "FAQ"
                  },
                  {
                    "type": "text",
                    "value": ".\nIf "
                  },
                  {
                    "type": "inlineCode",
                    "value": "About"
                  },
                  {
                    "type": "text",
                    "value": " is clicked, the content of "
                  },
                  {
                    "type": "inlineCode",
                    "value": "About"
                  },
                  {
                    "type": "text",
                    "value": " would be displayed under "
                  },
                  {
                    "type": "inlineCode",
                    "value": "Main"
                  },
                  {
                    "type": "text",
                    "value": "."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const Views = Routable({navigate: 'onNavigate'}, ({children}) => <div>{children}</div>);\n\nconst Main = () => (\n  <div>\n\t  <Link path=\"./about\">About</Link>\n\t  <Link path=\"./faq\">FAQ</Link>\n  </div>\n);\n\nconst About = () => (<div>Greetings! We are Enact team.</div>);\n\nconst Faq = () => (<div>List of FAQ</div>);\n\nconst Sample = (props) => {\n  // use 'main' for the default path\n  const [path, nav] = useState('main');\n  // if onNavigate is called with a new path, update the state\n  const handleNavigate = useCallback((ev) => nav(ev.path), [nav]);\n\n  return (\n\t  <Views {...props} path={path} onNavigate={handleNavigate}>\n\t\t  <Route path=\"main\" component={Main}>\n\t\t\t  <Route path=\"about\" component={About} />\n\t\t\t  <Route path=\"faq\" component={Faq} />\n\t\t  </Route>\n\t  </Views>\n  );\n};"
              }
            ]
          },
