        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "A higher-order component adds support to a component to handle "
                  },
                  {
                    "type": "inlineCode",
                    "value": "navigate"
                  },
                  {
                    "type": "text",
                    "value": " from "
                  },
                  {
                    "type": "link",
                    "url": "ui/Routable.Routable",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "Routable"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": ".\nIt has configuration placed in the first argument to define which event will be used to navigate.\n"
                  },
                  {
                    "type": "inlineCode",
                    "value": "onClick"
                  },
                  {
                    "type": "text",
                    "value": " event is used by default. Thus, if you don't configure it, the component should forward "
                  },
                  {
                    "type": "inlineCode",
                    "value": "onClick"
                  },
                  {
                    "type": "text",
                    "value": " event\nto make "
                  },
                  {
                    "type": "link",
                    "url": "ui/Routable.Routable",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "Routable"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " know when navigation is triggered."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const CustomItemBase = kind({\n  name: 'CustomItem',\n\n  handlers: {\n\t  onClick: handle(\n\t\t  forward('onClick')\n\t  )\n  },\n\n  render: ({...rest}) => {\n\t  return (\n\t\t  <div {...rest} />\n\t );\n  }\n});\n\nconst CustomItem = Linkable({navigate: 'onClick'}, CustomItemBase);\n// same as const CustomItem = Linkable(CustomItemBase);\n\nconst Main = () => (\n  <div>\n\t  <CustomItem path=\"./about\">About</CustomItem>\n\t  <CustomItem path=\"./faq\">FAQ</CustomItem>\n  </div>\n);"
              }
            ]
