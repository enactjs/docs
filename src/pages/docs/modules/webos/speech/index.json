        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "VoiceControlDecorator is a higher-order component that adds a callback for voice event\nto its wrapped component."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "By default, "
                  },
                  {
                    "type": "inlineCode",
                    "value": "onVoice"
                  },
                  {
                    "type": "text",
                    "value": " handler will be added to the node where "
                  },
                  {
                    "type": "inlineCode",
                    "value": "data-webos-voice-intent"
                  },
                  {
                    "type": "text",
                    "value": " attribute is declared.\nIn addition, if you need to specify a target node, "
                  },
                  {
                    "type": "inlineCode",
                    "value": "data-webos-voice-event-target"
                  },
                  {
                    "type": "text",
                    "value": " attribute can be used."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Usage:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "import {Component} from 'react';\nimport Item from '@enact/moonstone/Item';\nimport {VoiceControlDecorator} from '@enact/webos/speech';\n\nconst VoiceDiv = VoiceControlDecorator('div');\nconst VoiceItem = VoiceControlDecorator(Item);\n\nclass Sample extends Component {\n  handlePlayListControl = (e) => {\n    const {intent, control} = e.detail;\n    // Change the app status refer to the `control` value.\n  }\n\n  handlePlayContent = (e) => {\n    const {intent, value} = e.detail;\n    // Play content\n  }\n\n  render () {\n    return(\n      <div>\n        <VoiceDiv\n          data-webos-voice-intent='PlayListControl'\n          onVoice={this.handlePlayListControl}\n        />\n        <VoiceItem\n          data-webos-voice-intent='Select PlayContent'\n          onVoice={this.handlePlayContent}\n        >\n          The Dark Knight\n        </VoiceItem>\n      </div>\n    );\n  }\n}"
              }
            ]
          },
