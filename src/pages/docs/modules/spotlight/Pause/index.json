            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Acts as a semaphore for Spotlight pause state ensuring that only the last Pause instance can\nresume Spotlight."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "emphasis",
                    "children": [
                      {
                        "type": "text",
                        "value": "Note"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " "
                  },
                  {
                    "type": "link",
                    "url": "spotlight/Spotlight.resume",
                    "title": null,
                    "jsdoc": true,
                    "children": [
                      {
                        "type": "text",
                        "value": "spotlight/Spotlight.resume"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": " will always resume spotlight regardless of what last\npaused spotlight and can be used as an escape hatch to force resumption."
                  }
                ]
              }
            ]
          },
