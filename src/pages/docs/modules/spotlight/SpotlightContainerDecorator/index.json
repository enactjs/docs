        {
          "description": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Constructs a higher-order component that allows Spotlight focus to be passed to its own\nconfigurable hierarchy of spottable child controls."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Note: This HoC passes a number of props to the wrapped component that should be passed to the\nmain DOM node."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "const Component = ({myProp, ...rest}) => (\n\t<div {...rest}>{myProp}</div>\n);\n...\nconst DefaultContainer = SpotlightContainerDecorator(Component);\nconst FocusDefaultContainer = SpotlightContainerDecorator({enterTo: 'default-element'}, Component);"
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "To specify a default element to spot in a container, utilize the "
                  },
                  {
                    "type": "inlineCode",
                    "value": "spotlightDefaultClass"
                  },
                  {
                    "type": "text",
                    "value": "."
                  }
                ]
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Example:"
                  }
                ]
              },
              {
                "type": "code",
                "lang": null,
                "meta": null,
                "value": "import Spotlight from '@enact/spotlight';\nimport SpotlightContainerDecorator from '@enact/spotlight/SpotlightContainerDecorator';\nconst ContainerComponent = SpotlightContainerDecorator(Component);\nconst View = kind({\n\trender: () => {\n\t\t<ContainerComponent>\n\t\t\t<SpottableComponent>foo</SpottableComponent>\n\t\t\t<SpottableComponent className={spotlightDefaultClass}>spot me first</SpottableComponent>\n\t\t</ContainerComponent>\n\t}\n});"
              }
            ]
          },
