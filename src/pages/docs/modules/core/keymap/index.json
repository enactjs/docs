          "type": "code",
          "lang": null,
          "meta": null,
          "value": "import {add, is} from '@enact/core/keymap';\n\nadd('enter', 13);\nconst isEnter = is('enter');\n\n// within event handler\nif (isEnter(ev.keyCode)) {\n  // handle enter\n}"
