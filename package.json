{
  "name": "docs",
  "description": "Enact JavaScript Framework Docs",
  "version": "0.0.1",
  "scripts": {
    "serve": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fast-deploy": "npm run make-runner -- --fast && npm run build && npm run check-links",
    "parse-docs": "node scripts/parse-docs.js",
    "parse-pages": "node scripts/parse-pages.js",
    "make-runner": "node scripts/make-runner.js",
    "check-links": "linkinator ./dist --recurse --skip \"^(https://)\" --verbosity error"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.7",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.4.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "linkinator": "^6.1.2",
    "minimist": "^1.2.8",
    "shelljs": "^0.10.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0"
  }
}
