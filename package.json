{
  "name": "docs",
  "description": "Enact JavaScript Framework Docs",
  "version": "0.0.1",
  "scripts": {
    "serve": "astro dev",
    "build": "astro build && mkdir -p dist/404 && cp dist/404.html dist/404/index.html",
    "preview": "astro preview",
    "astro": "astro",
    "fast-deploy": "npm run make-runner -- --fast && astro build",
    "parse-docs": "node scripts/parse-docs.js",
    "parse-pages": "node scripts/parse-pages.js",
    "make-runner": "node scripts/make-runner.js"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/starlight": "^0.38.4",
    "astro": "^6.1.10"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.4.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "minimist": "^1.2.8",
    "shelljs": "^0.10.0"
  }
}
