{
  "name": "docs",
  "description": "Enact JavaScript Framework Docs",
  "version": "5.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "astro dev",
    "build": "astro build && node scripts/copy-404.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "fast-deploy": "npm run make-runner -- --fast && npm run build",
    "parse-docs": "node scripts/parse-docs.mjs",
    "parse-pages": "node scripts/parse-pages.mjs",
    "make-runner": "node scripts/make-runner.mjs",
    "check-links": "linkinator ./dist --recurse --verbosity error",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/react": "^7.1.5",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.8",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-enact": "^6.0.0",
    "linkinator": "^8.1.0",
    "minimist": "^1.2.8",
    "shelljs": "^0.10.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "vue-template-compiler": "npm:empty-npm-package@1.0.0",
    "minimatch": "^11.0.5",
    "linkinator": {
      "glob": "^14.0.4"
    }
  }
}
