{
  "name": "docs",
  "description": "Enact JavaScript Framework Docs",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "astro dev",
    "build": "astro build && node scripts/copy-404.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "fast-deploy": "npm run make-runner -- --fast && npm run build",
    "parse-docs": "node scripts/parse-docs.mjs",
    "parse-pages": "node scripts/parse-pages.mjs",
    "make-runner": "node scripts/make-runner.mjs",
    "check-links": "linkinator ./dist --recurse --verbosity error",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.7",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.4.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-enact": "^5.1.2",
    "linkinator": "^6.1.2",
    "minimist": "^1.2.8",
    "shelljs": "^0.10.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0"
  }
}
